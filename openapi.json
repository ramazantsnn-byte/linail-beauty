{
  "openapi": "3.1.0",
  "info": {
    "title": "Linail Beauty Studio VIP API",
    "description": "Structured API specification for Linail Beauty Studio in Ataşehir Uphill Towers, Istanbul.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://linailbeauty.com",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/services": {
      "get": {
        "summary": "Get Linail VIP Beauty Services & Pricing",
        "operationId": "getServices",
        "responses": {
          "200": {
            "description": "List of active VIP beauty services",
            "content": {
              "application/json": {
                "example": {
                  "studio": "Linail Beauty Studio",
                  "location": "Ataşehir Barbaros Mah. Uphill Towers B Blok Daire 14, Istanbul",
                  "parking": "Stüdyomuza özel tahsisli otopark alanı",
                  "whatsapp": "+905318696764",
                  "daily_capacity": "5 VIP clients per day",
                  "services": [
                    { "name": "Protez Jel Tırnak & Manikür - Kalıcı Oje", "price_try": 3000, "duration_min": 120 },
                    { "name": "Protez Jel Bakımı - Manikür - Kalıcı Oje", "price_try": 2400, "duration_min": 90 },
                    { "name": "Jel Güçlendirme & Manikür & Kalıcı Oje", "price_try": 2400, "duration_min": 90 },
                    { "name": "El Kalıcı Oje & Manikür", "price_try": 1800, "duration_min": 60 },
                    { "name": "Ayak Kalıcı Oje & Pedikür", "price_try": 2400, "duration_min": 75 },
                    { "name": "Rus Kuru Manikür - Steril Pedikür", "price_try": 2400, "duration_min": 90 },
                    { "name": "VIP 3'ü 1 Arada Eşzamanlı Seans (Tırnak + Kirpik + Pedikür)", "price_try": 6000, "duration_min": 150 }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/book": {
      "post": {
        "summary": "Direct VIP Appointment Booking Route",
        "operationId": "bookAppointment",
        "responses": {
          "200": {
            "description": "Direct WhatsApp concierge booking URL",
            "content": {
              "application/json": {
                "example": {
                  "booking_url": "https://wa.me/905318696764?text=Merhaba,%20Linail%20Studio%20i%C3%A7in%20randevu%20almak%20istiyorum."
                }
              }
            }
          }
        }
      }
    }
  }
}
